APP_NAME=LyricFlow API
APP_ENV=development
APP_DEBUG=true
APP_API_PREFIX=/api/v1
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Provider credentials belong only in the backend environment.
AUDD_API_KEY=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_HOST=
RECOGNITION_PROVIDER=audd
RECOGNITION_TIMEOUT_SECONDS=20
